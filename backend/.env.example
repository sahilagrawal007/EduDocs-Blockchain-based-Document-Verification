# ==========================================
# EduDocs Backend Environment Variables
# ==========================================

# 1. Supabase Credentials (REQUIRED)
# Found in your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# 2. Blockchain Settings (OPTIONAL - Defaults are provided)
# RPC_URL is the local Hardhat node URL
RPC_URL="http://127.0.0.1:8545"

# HARDHAT_FUNDER_KEY is used to auto-fund new issuer accounts (Default is Hardhat Account #0)
HARDHAT_FUNDER_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# CONTRACT_ADDRESS is the deployed contract. Usually auto-updated in backend/config.json, 
# but you can override it here if needed.
# CONTRACT_ADDRESS="0x..."

# 3. Email Settings (OPTIONAL)
# If left blank, the system will use Ethereal Mail for local testing and print preview URLs in the console.
# To send real emails (e.g., via Gmail), provide your credentials here.
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
